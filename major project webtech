<?php
require_once "config/db.php";

if ($_SERVER["REQUEST_METHOD"] !== "POST") {
    header("Location: index.php");
    exit;
}

$quiz_id = filter_input(INPUT_POST, "quiz_id", FILTER_VALIDATE_INT);
$answers = $_POST["answers"] ?? [];

if (!$quiz_id || !is_array($answers)) {
    die("Invalid quiz submission.");
}

try {
    // Check that the quiz exists
    $stmt = $pdo->prepare(
        "SELECT id FROM quizzes WHERE id = ?"
    );
    $stmt->execute([$quiz_id]);

    if (!$stmt->fetch()) {
        die("Quiz not found.");
    }

    // Get correct answers from database
    $stmt = $pdo->prepare(
        "SELECT id, correct_option
         FROM questions
         WHERE quiz_id = ?"
    );
    $stmt->execute([$quiz_id]);

    $questions = $stmt->fetchAll(PDO::FETCH_ASSOC);

    if (count($questions) === 0) {
        die("No questions found.");
    }

    $score = 0;
    $total = count($questions);

    // Calculate score
    foreach ($questions as $question) {
        $question_id = $question["id"];

        $selected = strtoupper(
            trim((string)($answers[$question_id] ?? ""))
        );

        $correct = strtoupper(
            trim((string)$question["correct_option"])
        );

        if (
            in_array($selected, ["A", "B", "C", "D"], true)
            && $selected === $correct
        ) {
            $score++;
        }
    }

    // Save result in database
    $stmt = $pdo->prepare(
        "INSERT INTO results (quiz_id, score, total_questions)
         VALUES (?, ?, ?)"
    );

    $stmt->execute([$quiz_id, $score, $total]);

    $result_id = $pdo->lastInsertId();

    // Open result page
    header("Location: result.php?id=" . $result_id);
    exit;

} catch (PDOException $e) {
    http_response_code(500);
    echo "Database error: " .
         htmlspecialchars($e->getMessage());
}
